<Window x:Class="WpfLb1.AdminWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
       Title="Админка" Height="400" Width="600">
    <StackPanel Margin="10">
        <!-- Секции -->
        <TextBlock Text="Управление секциями" 
                  FontWeight="Bold" 
                  Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <Button Content="Добавить секцию" 
                    Width="150" 
                    Margin="0,0,10,0" 
                    Click="OnAddSectionButtonClick"/>
            <Button Content="Удалить секцию" 
                    Width="150" 
                    Click="OnOpenDeleteSectionWindowClick"/>
        </StackPanel>

        <Separator Margin="0,0,0,20"/>

        <!-- Сервисы -->
        <TextBlock Text="Управление сервисами" 
                  FontWeight="Bold" 
                  Margin="0,0,0,10"/>

        <Button Content="Открыть управление сервисами" 
                Width="250"
                Click="OnOpenServiceManagement_Click"
                Style="{StaticResource MaterialDesignRaisedButton}"/>
    </StackPanel>
</Window>