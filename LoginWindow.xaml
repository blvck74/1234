<Window x:Class="WpfLb1.LoginWindow"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       Title="Login" Height="250" Width="400">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBox x:Name="NicknameTextBox" Width="200" Margin="0,0,0,10" Tag="Введите никнейм" GotFocus="RemovePlaceholder" LostFocus="AddPlaceholder"/>
            <PasswordBox x:Name="PasswordBox" Width="200" Margin="0,0,0,10" Tag="Введите пароль"/>
            <Button Content="Войти" Width="100" Click="OnLoginButtonClick"/>
        </StackPanel>
    </Grid>
</Window>