<UserControl x:Class="WpfLb1.DashboardTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:WpfLb1"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Background="{DynamicResource MaterialDesignPaper}">

    <materialDesign:Card Margin="16" VerticalAlignment="Stretch" 
                        Background="{DynamicResource MaterialDesignBackground}"
                        materialDesign:ElevationAssist.Elevation="Dp2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Панель управления -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" 
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <StackPanel Orientation="Horizontal" Margin="16,8" 
                          x:Name="ControlPanel">
                    <Button x:Name="BackButton" Content="Назад" 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            materialDesign:ButtonAssist.CornerRadius="4"
                            Margin="0,0,8,0"
                            Click="OnBackClick" 
                            Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ArrowLeft" 
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Назад"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="AddInfoButton" Content="Добавить информацию"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            materialDesign:ButtonAssist.CornerRadius="4"
                            Margin="0,0,8,0"
                            Click="OnAddInfoClick" 
                            Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" 
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Добавить информацию"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="DeleteButton" Content="Удалить"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            materialDesign:ButtonAssist.CornerRadius="4"
                            Foreground="{DynamicResource MaterialDesignError}"
                            Margin="0,0,8,0"
                            Click="OnDeleteClick" 
                            Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Delete" 
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Удалить"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                    <Button x:Name="EditButton" Content="Редактировать"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            materialDesign:ButtonAssist.CornerRadius="4"
                            Margin="0,0,8,0"
                            Click="OnEditClick" 
                            Visibility="Collapsed">
                        <Button.ContentTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Edit" 
                                                           Margin="0,0,8,0"/>
                                    <TextBlock Text="Редактировать"/>
                                </StackPanel>
                            </DataTemplate>
                        </Button.ContentTemplate>
                    </Button>

                   
                </StackPanel>
            </materialDesign:Card>

            <!-- Основное содержимое -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto" 
                         HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ServicesPanel" 
                             ItemsSource="{Binding DashboardItems}"
                             Margin="16,0,16,16">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl>
                                <ContentControl.Style>
                                    <Style TargetType="ContentControl">
                                        <!-- Шаблон по умолчанию для секций и тем (кнопки) -->
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate>
                                                    <materialDesign:Card Margin="8" 
                                                                       materialDesign:ElevationAssist.Elevation="Dp1"
                                                                       UniformCornerRadius="8">
                                                        <Button Width="220"
                                                                Height="64"
                                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                                materialDesign:ButtonAssist.CornerRadius="8"
                                                                Click="OnDashboardButtonClick">
                                                            <TextBlock Text="{Binding Name}"
                                                                       TextWrapping="Wrap"
                                                                       TextAlignment="Center"
                                                                       FontSize="14"/>
                                                        </Button>
                                                    </materialDesign:Card>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                        <!-- Шаблон для отображения Markdown контента -->
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Section}" Value="{x:Null}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate>
                                                            <materialDesign:Card Margin="8" 
                                                                               Padding="16"
                                                                               materialDesign:ElevationAssist.Elevation="Dp1"
                                                                               UniformCornerRadius="8">
                                                                    <local:MarkdownViewer Markdown="{Binding Content}"
                                                                               VerticalAlignment="Stretch"
                                                                               HorizontalAlignment="Stretch"/>
                                                            </materialDesign:Card>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentControl.Style>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </materialDesign:Card>
</UserControl>
