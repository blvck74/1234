<Window x:Class="WpfLb1.EditTopicWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:local="clr-namespace:WpfLb1"
        Title="Редактировать тему" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Панель инструментов Markdown -->
        <StackPanel Grid.Row="0" 
                    Orientation="Horizontal" 
                    Margin="16,8">
            <Button Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="Жирный текст"
                    Click="OnBoldClick"
                    Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="FormatBold"/>
            </Button>
            <Button Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="Курсив"
                    Click="OnItalicClick"
                    Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="FormatItalic"/>
            </Button>
            <Button Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="Код"
                    Click="OnCodeClick"
                    Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="CodeTags"/>
            </Button>
            <Button Style="{StaticResource MaterialDesignToolButton}"
                    ToolTip="Ссылка"
                    Click="OnLinkClick"
                    Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="Link"/>
            </Button>
        </StackPanel>

        <!-- Основная область с редактором и предпросмотром -->
        <Grid Grid.Row="1" Margin="16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Редактор слева -->
            <TextBox x:Name="ContentEditor"
                     Grid.Column="0"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     materialDesign:HintAssist.Hint="Введите текст используя Markdown"
                     FontFamily="Consolas"
                     TextChanged="OnTextChanged"/>

            <!-- Разделитель -->
            <GridSplitter Grid.Column="1"
                          Width="5"
                          ResizeBehavior="PreviousAndNext"
                          Background="{DynamicResource MaterialDesignDivider}"/>

            <!-- Предпросмотр справа -->
            <materialDesign:Card Grid.Column="2"
                                Margin="8,0,0,0"
                                Padding="16"
                                materialDesign:ElevationAssist.Elevation="Dp1">
                <local:MarkdownViewer x:Name="MarkdownPreview"/>
            </materialDesign:Card>
        </Grid>

        <!-- Кнопки -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right" 
                    Margin="16">
            <Button Content="Отмена" 
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="Cancel_Click" 
                    Margin="0,0,8,0"/>
            <Button Content="Сохранить"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="OnSaveClick"/>
        </StackPanel>
    </Grid>
</Window>
