<Window x:Class="WpfLb1.AddSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить секцию" Height="200" Width="300">
    <StackPanel Margin="10">
        <TextBlock Text="Введите название секции:" Margin="0,0,0,10"/>
        <TextBox x:Name="SectionNameTextBox" Width="200" Margin="0,0,0,10"/>
        <Button Content="Добавить" Width="100" HorizontalAlignment="Center" Click="OnAddButtonClick"/>
    </StackPanel>
</Window>