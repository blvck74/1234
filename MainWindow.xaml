<Window
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
   xmlns:local="clr-namespace:WpfLb1"
   xmlns:controls="clr-namespace:System.Windows.Controls;assembly=PresentationFramework"
   x:Class="WpfLb1.MainWindow"
   Title="Dashboard" Height="700" Width="1200"
   TextElement.Foreground="{DynamicResource MaterialDesignBody}"
   Background="{DynamicResource MaterialDesignPaper}"
   TextElement.FontWeight="Regular"
   TextElement.FontSize="13"
   TextOptions.TextFormattingMode="Ideal"
   TextOptions.TextRenderingMode="Auto"
   FontFamily="{materialDesign:MaterialDesignFont}">

    <Window.Resources>
        <Storyboard x:Key="TabChangeStoryboard">
            <DoubleAnimation
                From="0" To="1"
                Duration="0:0:0.3"
                Storyboard.TargetProperty="Opacity">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseInOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <materialDesign:Card Margin="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <controls:TabControl x:Name="MainTabControl" 
                          Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                          TabStripPlacement="Left"
                          SelectionChanged="MainTabControl_SelectionChanged"
                          Grid.ColumnSpan="2">

                    <TabControl.ContentTemplate>
                        <DataTemplate>
                            <Grid>
                                <ContentPresenter Content="{Binding}">
                                    <ContentPresenter.Style>
                                        <Style TargetType="ContentPresenter">
                                            <Style.Triggers>
                                                <EventTrigger RoutedEvent="Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                From="0" To="1"
                                                                Duration="0:0:0.3"
                                                                Storyboard.TargetProperty="Opacity">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseInOut"/>
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentPresenter.Style>
                                </ContentPresenter>
                            </Grid>
                        </DataTemplate>
                    </TabControl.ContentTemplate>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Дашборд" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:DashboardTab />
                    </TabItem>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Transfer" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Передача смены" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:ShiftTransferTab />
                    </TabItem>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Clock" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Оперативка" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:OperativeTab />
                    </TabItem>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Work" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Модель Здоровья" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:HealthModelTab />
                    </TabItem>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Work" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Работы" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:WorksTab />
                    </TabItem>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Alert" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Аварии" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:IncidentsTab />
                    </TabItem>

                    <TabItem Style="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <TabItem.Header>
                            <StackPanel>
                                <materialDesign:PackIcon Kind="Settings" Width="24" Height="24" 
                                                       HorizontalAlignment="Center"/>
                                <TextBlock Text="Админка" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </TabItem.Header>
                        <local:AdminTab />
                    </TabItem>
                </controls:TabControl>
            </Grid>
        </materialDesign:Card>
    </Grid>
</Window>
