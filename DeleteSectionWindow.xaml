<Window x:Class="WpfLb1.DeleteSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Удалить секцию" Height="200" Width="300">
    <StackPanel Margin="10">
        <TextBlock Text="Выберите секцию для удаления:" Margin="0,0,0,10"/>
        <ComboBox x:Name="SectionComboBox" Width="200" Margin="0,0,0,10"/>
        <Button Content="Удалить" Width="100" HorizontalAlignment="Center" Click="OnDeleteButtonClick"/>
    </StackPanel>
</Window>